---
import { site } from '../data/site';

interface Props {
  credit: string;
  brandLabel?: string;
}

const { credit, brandLabel } = Astro.props;
---

<footer class="site-footer">
  <div class="shell footer-layout">
    <a class="footer-brand" href="/" aria-label={brandLabel}>
      PS<span>.</span>
    </a>
    <span>
      © {new Date().getFullYear()} {site.name} · {credit}
    </span>
    <a href="#main">BACK TO TOP ↑</a>
  </div>
</footer>
