---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0b1013" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url.href} />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('portfolio-theme');
          const theme =
            stored === 'light' || stored === 'dark'
              ? stored
              : matchMedia('(prefers-color-scheme: light)').matches
                ? 'light'
                : 'dark';
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = 'dark';
        }
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <slot />
    <script>
      const themeButton = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
      const syncTheme = () => {
        if (themeButton)
          themeButton.setAttribute(
            'aria-label',
            `Switch to ${document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark'} mode`,
          );
      };
      syncTheme();
      themeButton?.addEventListener('click', () => {
        const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('portfolio-theme', next);
        } catch {}
        syncTheme();
      });
      const header = document.querySelector<HTMLElement>('[data-site-header]');
      const nav = header?.querySelector<HTMLElement>('[data-mobile-nav]');
      const navButton = header?.querySelector<HTMLButtonElement>('[data-menu-toggle]');
      const desktopNav = header?.querySelector<HTMLElement>('.desktop-nav');

      if (header && nav && navButton && desktopNav) {
        const mobileViewport = matchMedia('(max-width: 800px)');
        const availabilityLink = header.querySelector<HTMLAnchorElement>('.availability-link');
        let isOpen = false;
        let wasMobile = mobileViewport.matches;

        const setMenuOpen = (open: boolean) => {
          isOpen = open && mobileViewport.matches;
          nav.classList.toggle('is-open', isOpen);
          navButton.setAttribute('aria-expanded', String(isOpen));
          navButton.setAttribute('aria-label', isOpen ? 'Close navigation' : 'Open navigation');
        };

        const syncViewport = (focused: Element | null = document.activeElement) => {
          if (mobileViewport.matches === wasMobile) return;
          wasMobile = mobileViewport.matches;
          let nextFocus: HTMLElement | null = null;
          if (!wasMobile && (focused === navButton || nav.contains(focused))) {
            const links = [...desktopNav.querySelectorAll<HTMLAnchorElement>('a')];
            nextFocus =
              links.find(
                (link) => focused instanceof HTMLAnchorElement && link.href === focused.href,
              ) ??
              links[0] ??
              null;
          } else if (wasMobile && (desktopNav.contains(focused) || focused === availabilityLink)) {
            nextFocus = navButton;
          }
          setMenuOpen(false);
          nextFocus?.focus({ preventScroll: true });
        };

        navButton.addEventListener('click', () => {
          const focusWasInNav = nav.contains(document.activeElement);
          setMenuOpen(!isOpen);
          if (!isOpen && focusWasInNav) navButton.focus({ preventScroll: true });
        });

        document.addEventListener('keydown', (event) => {
          if (event.key !== 'Escape' || event.defaultPrevented || !isOpen) return;
          const focusWasInNav = nav.contains(document.activeElement);
          setMenuOpen(false);
          if (focusWasInNav) {
            event.preventDefault();
            navButton.focus({ preventScroll: true });
          }
        });

        header.addEventListener('focusout', (event) => {
          const next = event.relatedTarget;
          // CSS can blur a disappearing control before the media-query event fires.
          if (next === null && event.target instanceof Element) syncViewport(event.target);
          if (isOpen && next instanceof Node && next !== navButton && !nav.contains(next)) {
            setMenuOpen(false);
          }
        });

        nav.querySelectorAll<HTMLAnchorElement>('a').forEach((link) => {
          link.addEventListener('click', (event) => {
            if (
              event.defaultPrevented ||
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.shiftKey ||
              event.altKey
            )
              return;
            if (link.hasAttribute('download') || (link.target && link.target !== '_self')) return;
            const destination = new URL(link.href);
            if (
              destination.origin !== location.origin ||
              destination.pathname !== location.pathname ||
              destination.search !== location.search
            )
              return;
            const target = document.getElementById(destination.hash.slice(1));
            if (!target) return;

            setMenuOpen(false);
            target.focus({ preventScroll: true });
            // Leave the default link action intact for scrolling and browser history.
          });
        });

        mobileViewport.addEventListener('change', () => syncViewport());

        // Keep an already-focused fallback link visible during delayed initialization.
        setMenuOpen(nav.contains(document.activeElement));
        header.dataset.navReady = '';
      }
    </script>
  </body>
</html>
