---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/achievements.css';

const featured = [
  {
    number: '01',
    event: 'CODING NINJAS CODEKAZE',
    year: '2021',
    value: '205',
    qualifier: 'ALL INDIA RANK',
    detail: 'Competitive programming · National result',
    certificate: 'https://drive.google.com/file/d/1-kY0pMkFlo_hTFd_OA3G8_6mwjwFZ8ab/view',
  },
  {
    number: '02',
    event: 'CREDIT SUISSE GLOBAL CODING CHALLENGE',
    year: '2021',
    value: '414',
    qualifier: 'GLOBAL RANK',
    detail: 'Global coding challenge',
    certificate: 'https://drive.google.com/file/d/1nY5ykZ9QX_hfKuAjIA55qb_f6HJ-uTKj/view',
  },
  {
    number: '03',
    event: 'GOOGLE KICK START',
    year: '2022',
    value: '1,645',
    qualifier: 'GLOBAL RANK',
    detail: 'Round B',
    certificate: 'https://drive.google.com/file/d/1nLA4zTHuIpDyjLdVM90otzfvzVV2v0Fb/view',
  },
  {
    number: '04',
    event: 'GOOGLE CODE JAM',
    year: '2022',
    value: '2,986',
    qualifier: 'GLOBAL RANK',
    detail: 'Round 1C',
    certificate: 'https://drive.google.com/file/d/15VnLQCXKvLmVBg8hYJ4upv8ojJyErL7i/view',
  },
] as const;

const competitionRecord = [
  {
    event: 'Coding Ninjas CodeKaze',
    year: '2021',
    round: 'Competition',
    result: 'All India Rank 205',
    evidence: 'https://drive.google.com/file/d/1-kY0pMkFlo_hTFd_OA3G8_6mwjwFZ8ab/view',
  },
  {
    event: 'Credit Suisse Global Coding Challenge',
    year: '2021',
    round: 'Global competition',
    result: 'Global Rank 414',
    evidence: 'https://drive.google.com/file/d/1nY5ykZ9QX_hfKuAjIA55qb_f6HJ-uTKj/view',
  },
  {
    event: 'Google Kick Start',
    year: '2022',
    round: 'Round B',
    result: 'Global Rank 1,645',
    evidence: 'https://drive.google.com/file/d/1nLA4zTHuIpDyjLdVM90otzfvzVV2v0Fb/view',
  },
  {
    event: 'Google Kick Start',
    year: '2021',
    round: 'Round G',
    result: 'Global Rank 1,855',
    evidence:
      'https://drive.google.com/file/d/1axD3Bx1p1qhleK3x3QwvdyUxLhQAQV2v/view?usp=share_link',
  },
  {
    event: 'Google Code Jam',
    year: '2022',
    round: 'Round 1C',
    result: 'Global Rank 2,986',
    evidence: 'https://drive.google.com/file/d/15VnLQCXKvLmVBg8hYJ4upv8ojJyErL7i/view',
  },
  {
    event: 'Meta Hacker Cup',
    year: '2022',
    round: 'Round 2',
    result: 'Global Rank 2,993',
    evidence:
      'https://drive.google.com/file/d/19E9gp90GcKJvi4drhqhlTsEuYqZT9wQZ/view?usp=share_link',
  },
  {
    event: 'Meta Hacker Cup',
    year: '2021',
    round: 'Round 2',
    result: 'Global Rank 2,826',
    evidence:
      'https://drive.google.com/file/d/1PQ11AxE9oXvIiG4M9dFRIKBbuJijlfDD/view?usp=share_link',
  },
  {
    event: 'GATE',
    year: '2022',
    round: 'Graduate Aptitude Test in Engineering',
    result: 'All India Rank 3,933 · Score 468',
    evidence: 'https://drive.google.com/file/d/1_VHNggEnH0oGbfJLZPK98J5X732k9-wq/view',
  },
  {
    event: 'Google Hash Code',
    year: '2022',
    round: 'Team programming competition',
    result: '37,664 points',
    evidence: 'https://drive.google.com/file/d/1Jh4DWpeUzDIo5e9bR5xzHufvSFdkJlwx/view',
  },
  {
    event: 'CodeChef SnackDown',
    year: '2021',
    round: 'Pre-elimination round',
    result: 'Pre-elimination round',
    evidence: 'https://drive.google.com/file/d/1mQf4ttd68Fe85s_cnlEY8U_UtwnIvMVS/view',
  },
] as const;

const credential = {
  title: 'Amazon Security Certificate',
  description:
    'An earlier certificate retained from my original portfolio. I have preserved its original title and supporting link rather than guessing a course name or credential level.',
  evidence: 'https://drive.google.com/file/d/1DUc2h1U28Wz6YJAODFNLMe5NW5Vg_dL8/view',
} as const;

const title = 'Achievements & Certifications — Priyansh Sharma';
const description =
  'Competitive programming results, examination achievements and earlier credentials from Priyansh Sharma.';
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main" class="achievements-page">
    <section class="ach-hero shell" aria-labelledby="ach-title">
      <div class="ach-topline">
        <a class="ach-back" href="/#experience">
          ← Back to the homepage
        </a>
        <span>ACHIEVEMENTS / PRIYANSH SHARMA</span>
      </div>
      <div class="ach-hero-grid">
        <div>
          <p class="ach-kicker">PROBLEM SOLVING · COMPETITIONS · CREDENTIALS</p>
          <h1 id="ach-title">
            Before the systems, <em>there were problems to solve.</em>
          </h1>
          <p class="ach-intro">
            Algorithms and competitive programming were a big part of how I learned to think about
            constraints, correctness and efficient solutions. These are the results and credentials
            I kept from those earlier years.
          </p>
        </div>
        <aside class="ach-hero-aside" aria-label="Collection overview">
          <span class="ach-aside-kicker">THE RECORD</span>
          <div>
            <strong>10</strong>
            <span>Competition and examination results</span>
          </div>
          <div>
            <strong>04</strong>
            <span>Selected placements highlighted</span>
          </div>
          <div>
            <strong>01</strong>
            <span>Earlier certificate</span>
          </div>
        </aside>
      </div>
      <nav class="ach-jump" aria-label="Achievements categories">
        <a href="#highlights">
          01 / Selected results <span aria-hidden="true">↓</span>
        </a>
        <a href="#record">
          02 / Complete record <span aria-hidden="true">↓</span>
        </a>
        <a href="#credentials">
          03 / Credentials <span aria-hidden="true">↓</span>
        </a>
      </nav>
    </section>

    <section
      class="ach-section shell"
      id="highlights"
      tabindex="-1"
      aria-labelledby="ach-highlights-title"
    >
      <div class="ach-section-intro">
        <div>
          <p class="ach-kicker">01 / SELECTED RESULTS</p>
          <h2 id="ach-highlights-title">
            A few results that <em>stayed with me.</em>
          </h2>
        </div>
        <p>
          Each ranking belongs to a particular competition and year. I prefer keeping that context
          visible rather than presenting a number without explaining what it measures.
        </p>
      </div>
      <div class="ach-feature-grid">
        {featured.map((item) => (
          <article class="ach-feature">
            <div class="ach-feature-top">
              <span>{item.number} / 04</span>
              <span>{item.year}</span>
            </div>
            <p class="ach-feature-event">{item.event}</p>
            <div class="ach-rank">
              <span>{item.qualifier}</span>
              <strong>{item.value}</strong>
            </div>
            <div class="ach-feature-bottom">
              <span>{item.detail}</span>
              <a href={item.certificate} target="_blank" rel="noopener noreferrer">
                Original record <span aria-hidden="true">↗</span>
              </a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section
      class="ach-record-section"
      id="record"
      tabindex="-1"
      aria-labelledby="ach-record-title"
    >
      <div class="shell">
        <div class="ach-section-intro">
          <div>
            <p class="ach-kicker">02 / COMPLETE COMPETITION RECORD</p>
            <h2 id="ach-record-title">
              The complete <em>picture.</em>
            </h2>
          </div>
          <p>
            All ten results from my original portfolio, including contests where I participated
            without recording a placement. The original supporting links are retained.
          </p>
        </div>
        <div class="ach-ledger">
          <div class="ach-ledger-head" aria-hidden="true">
            <span>NO.</span>
            <span>COMPETITION / YEAR</span>
            <span>RESULT</span>
            <span>RECORD</span>
          </div>
          <ol class="ach-ledger-list">
            {competitionRecord.map((item, index) => (
              <li class="ach-ledger-row">
                <span class="ach-row-index">{String(index + 1).padStart(2, '0')}</span>
                <div class="ach-row-event">
                  <strong>{item.event}</strong>
                  <span>
                    {item.year} · {item.round}
                  </span>
                </div>
                <p class="ach-row-result">{item.result}</p>
                <a
                  class="ach-evidence"
                  href={item.evidence}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  View record <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section
      class="ach-section shell ach-credentials"
      id="credentials"
      tabindex="-1"
      aria-labelledby="ach-credentials-title"
    >
      <div class="ach-section-intro">
        <div>
          <p class="ach-kicker">03 / CERTIFICATIONS & CREDENTIALS</p>
          <h2 id="ach-credentials-title">
            One more part of <em>the record.</em>
          </h2>
        </div>
        <p>
          I've kept this separate from competition placements. A certificate and a contest ranking
          are different types of achievements.
        </p>
      </div>
      <article class="ach-credential">
        <div class="ach-credential-index">
          <span>01 / EARLIER CERTIFICATE</span>
          <span aria-hidden="true" class="ach-credential-glyph">
            ✳
          </span>
        </div>
        <div class="ach-credential-body">
          <h3>{credential.title}</h3>
          <p>{credential.description}</p>
          <a
            class="ach-action"
            href={credential.evidence}
            target="_blank"
            rel="noopener noreferrer"
          >
            View original certificate <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
      <p class="ach-source-note">
        This collection preserves results and document links from my earlier portfolio. I haven't
        independently revalidated every certificate destination; the labels reflect the original
        records, with additional round detail where included in my résumé.
      </p>
    </section>

    <section class="ach-lastword" aria-labelledby="ach-lastword-title">
      <div class="shell ach-lastword-content">
        <div>
          <p class="ach-kicker">WHAT CAME NEXT</p>
          <h2 id="ach-lastword-title">
            The problems changed. <em>The curiosity didn't.</em>
          </h2>
          <p>
            That early focus on algorithms carried into the backend systems and engineering work I
            do today.
          </p>
        </div>
        <div class="ach-lastword-actions">
          <a class="button button-primary" href="/#work">
            Explore my engineering work <span aria-hidden="true">↗</span>
          </a>
          <a class="ach-action" href="/coding-profiles/">
            Explore coding profiles <span aria-hidden="true">↗</span>
          </a>
          <a class="ach-action" href="/projects/">
            Browse projects <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer credit="Designed and built with care." brandLabel="Back to homepage" />
</BaseLayout>
