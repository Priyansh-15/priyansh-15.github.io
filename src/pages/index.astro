---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../data/site';
import '../styles/section-experience.css';
---

<BaseLayout>
  <Header />
  <main id="main" class="portfolio-home">
    <div class="landing-stage" id="top" tabindex="-1" data-scroll-stage>
      <section class="intro shell" aria-labelledby="intro-title">
        <div class="intro-content">
          <p class="eyebrow">
            <span class="tiny-star" aria-hidden="true">
              ✳
            </span>{' '}
            <span class="eyebrow-identity">
              Hello, I'm <strong>Priyansh Sharma</strong>
            </span>
            <span class="eyebrow-end">/ Backend &amp; Distributed Systems Engineer</span>
          </p>
          <h1 id="intro-title">
            I make the complicated parts <em>work together.</em>
          </h1>
          <p class="intro-lede">
            I'm a software engineer at <strong>Thales</strong>. I take complex, open-ended problems
            from requirements through architecture, implementation, and validation. My work spans
            distributed systems, backend orchestration, stateful workflows, and AI-powered developer
            tooling.
          </p>
          <p class="intro-secondary">
            I care about understanding the whole problem, making deliberate tradeoffs, and building
            systems that stay reliable, understandable, and adaptable as they evolve.
          </p>
          <div class="intro-links">
            <a class="button button-primary" href="#work">
              See what I've worked on <span aria-hidden="true">↗</span>
            </a>
            <a
              class="underline-link"
              href="/Priyansh_Sharma_Resume.pdf"
              target="_blank"
              rel="noopener noreferrer"
            >
              Résumé <span aria-hidden="true">↗</span>
            </a>
            <a class="underline-link" href={site.github} target="_blank" rel="noopener noreferrer">
              GitHub <span aria-hidden="true">↗</span>
            </a>
            <a
              class="underline-link"
              href={site.linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >
              LinkedIn <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
        <aside class="intro-aside" aria-label="A note about my work">
          <div class="note-top">
            <span>IN MY OWN WORDS</span>
            <span class="note-asterisk" aria-hidden="true">
              ✳
            </span>
          </div>
          <div class="note-body">
            <p>I enjoy problems that don't come with a ready-made solution.</p>
            <p>
              I like digging into how things work, questioning assumptions, connecting the pieces,
              and building something better than what was there before.
            </p>
            <p>
              <strong>
                For me, good engineering isn't just about getting something to work. It's about
                understanding why it works, what could break, and how to make it better.
              </strong>
            </p>
          </div>
          <div class="note-bottom">
            <span>01 — WHAT KEEPS ME CURIOUS</span>
            <span aria-hidden="true">↗</span>
          </div>
        </aside>
      </section>

      <nav class="stage-cue stage-cue--next stage-cue--hero shell" aria-label="Next section">
        <a href="#work">
          <span class="stage-cue-arrow" aria-hidden="true">
            ↓
          </span>
          <span>Next: Selected Work</span>
        </a>
      </nav>

      <div class="marquee-rule">
        <div class="shell factline">
          <span>NOIDA, INDIA</span>
          <span class="fact-separator" aria-hidden="true">
            ·
          </span>
          <span>BACKEND ARCHITECTURE</span>
          <span class="fact-separator" aria-hidden="true">
            ·
          </span>
          <span>DISTRIBUTED SYSTEMS</span>
          <span class="fact-separator" aria-hidden="true">
            ·
          </span>
          <span>APPLIED AI & LLM SYSTEMS</span>
        </div>
      </div>
    </div>

    <section
      class="work-section shell section-spacing"
      id="work"
      tabindex="-1"
      data-scroll-stage
      aria-labelledby="work-title"
    >
      <div class="work-opening">
        <nav class="stage-cue stage-cue--previous" aria-label="Previous section">
          <a href="#top">
            <span class="stage-cue-arrow" aria-hidden="true">
              ↑
            </span>
            <span>Previous: Introduction</span>
          </a>
        </nav>
        <div class="section-intro-row">
          <div>
            <p class="section-kicker">01 / SELECTED WORK</p>
            <h2 id="work-title">
              A few problems I've <span class="serif-accent">worked on.</span>
            </h2>
          </div>
          <p>
            A closer look at the systems I've built, the problems behind them, and the design
            decisions that mattered.
          </p>
        </div>

        <div class="story-list">
          <article class="story story-featured">
            <div class="story-detail">
              <div class="story-topline">
                <span>01 / DISTRIBUTED PROCESSING</span>
                <span>PROFESSIONAL WORK</span>
              </div>
              <h3>Designing the core engine for distributed billing.</h3>
              <div class="story-narrative" aria-label="Billing problem and engineering approach">
                <p class="story-insight story-insight--challenge">
                  <span class="story-insight-label">THE CHALLENGE</span>
                  Usage-based billing had to apply configured prices and discount tiers per device
                  or across a tenant's usage. Splitting that work across workers meant preserving
                  the pricing rules and knowing when the report was complete.
                </p>
                <p class="story-insight story-insight--approach">
                  <span class="story-insight-label">MY APPROACH</span>I independently architected
                  and implemented the core bill-run engine, from mapping through reporting. I used
                  Cassandra-backed coordination to preserve stage progress across worker
                  interruptions and make recovery part of the execution design.
                </p>
              </div>
              <div class="story-tags">
                <span>Java</span>
                <span>Concurrency</span>
                <span>Cassandra</span>
                <span>Processing pipelines</span>
              </div>
              <a class="case-study-link" href="/work/distributed-billing/">
                Read the engineering case study <span aria-hidden="true">↗</span>
              </a>
            </div>
            <div
              class="story-visual pipeline-visual"
              role="group"
              aria-label="Illustrative stages of a data processing pipeline"
            >
              <div class="visual-label">
                A SYSTEM, IN STAGES <span>FIG. 01</span>
              </div>
              <div class="pipeline-layout">
                <div class="pipeline-stage">
                  <span class="stage-num">01</span>
                  <strong>Map</strong>
                  <small>Distribute work</small>
                </div>
                <span class="pipeline-arrow" aria-hidden="true">
                  →
                </span>
                <div class="pipeline-stage">
                  <span class="stage-num">02</span>
                  <strong>Reduce</strong>
                  <small>Aggregate</small>
                </div>
                <span class="pipeline-arrow" aria-hidden="true">
                  →
                </span>
                <div class="pipeline-stage">
                  <span class="stage-num">03</span>
                  <strong>Finalize</strong>
                  <small>Build output</small>
                </div>
              </div>
              <div class="visual-bottom">
                <span>COORDINATION MATTERS BETWEEN THE BOXES.</span>
                <span>↗</span>
              </div>
            </div>
          </article>
        </div>
        <nav class="stage-cue stage-cue--next" aria-label="Next section">
          <a href="#fleet-interactions">
            <span class="stage-cue-arrow" aria-hidden="true">
              ↓
            </span>
            <span>Next: Fleet Interactions</span>
          </a>
        </nav>
      </div>
      <div class="story-list story-list--continuation">
        <article class="story story-split" id="fleet-interactions" tabindex="-1" data-scroll-stage>
          <nav class="stage-cue stage-cue--previous" aria-label="Previous section">
            <a href="#work">
              <span class="stage-cue-arrow" aria-hidden="true">
                ↑
              </span>
              <span>Previous: Distributed Billing</span>
            </a>
          </nav>
          <div class="story-detail">
            <div class="story-topline">
              <span>02 / SYSTEM DESIGN</span>
              <span>PROFESSIONAL WORK</span>
            </div>
            <h3>Redesigning the framework for Fleet interactions.</h3>
            <div class="story-narrative" aria-label="Fleet problem and engineering approach">
              <p class="story-insight story-insight--challenge">
                <span class="story-insight-label">THE CHALLENGE</span>
                Fleet decisions and calls were spread across existing Order Scheduler paths.
              </p>
              <p class="story-insight story-insight--approach">
                <span class="story-insight-label">MY APPROACH</span>
                In October 2026, I designed and implemented a centralized Fleet interaction
                framework, separating side-effect-free planning from execution. I introduced it in
                stages, with established scheduler and provider-facing behavior as a compatibility
                constraint.
              </p>
            </div>
            <div class="story-tags">
              <span>Architecture</span>
              <span>Orchestration</span>
              <span>Reliability</span>
            </div>
            <a class="case-study-link" href="/work/order-scheduler/">
              Read the engineering case study <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div
            class="story-visual split-visual"
            role="group"
            aria-label="Conceptual separation of decision and execution"
          >
            <div class="visual-label">
              SEPARATE THE CONCERNS <span>FIG. 02</span>
            </div>
            <div class="split-diagram">
              <div>
                <small>DECIDE</small>
                <strong>Planner</strong>
                <span>What should happen?</span>
              </div>
              <span class="vertical-separator" aria-hidden="true">
                ↔
              </span>
              <div>
                <small>DO</small>
                <strong>Executor</strong>
                <span>How does it happen?</span>
              </div>
            </div>
            <div class="visual-bottom">
              <span>ILLUSTRATIVE, NOT AN INTERNAL DESIGN DOCUMENT</span>
            </div>
          </div>
          <nav class="stage-cue stage-cue--next" aria-label="Next section">
            <a href="#ai-code-intelligence">
              <span class="stage-cue-arrow" aria-hidden="true">
                ↓
              </span>
              <span>Next: AI Code Intelligence</span>
            </a>
          </nav>
        </article>
        <article
          class="story story-split"
          id="ai-code-intelligence"
          tabindex="-1"
          data-scroll-stage
        >
          <nav class="stage-cue stage-cue--previous" aria-label="Previous section">
            <a href="#fleet-interactions">
              <span class="stage-cue-arrow" aria-hidden="true">
                ↑
              </span>
              <span>Previous: Fleet Interactions</span>
            </a>
          </nav>
          <div class="story-detail">
            <div class="story-topline">
              <span>03 / SELF-INITIATED ENGINEERING</span>
              <span>TEAM-ADOPTED TOOLING</span>
            </div>
            <h3>Helping AI keep up with a real codebase.</h3>
            <div
              class="story-narrative"
              aria-label="Code intelligence problem and engineering approach"
            >
              <p class="story-insight story-insight--challenge">
                <span class="story-insight-label">THE CHALLENGE</span>
                While working with large backend codebases at Thales, I kept seeing AI tools lose
                important architecture and context between sessions.
              </p>
              <p class="story-insight story-insight--approach">
                <span class="story-insight-label">MY APPROACH</span>I took the initiative to build a
                persistent engineering knowledge system using AST-aware indexing, structured
                context, Qdrant/Neo4j retrieval, and MCP integrations. My entire team later adopted
                it.
              </p>
            </div>
            <div class="story-tags">
              <span>Code intelligence</span>
              <span>Persistent context</span>
              <span>MCP & retrieval</span>
            </div>
            <a class="case-study-link" href="/projects/#code-intelligence">
              Explore this initiative <span aria-hidden="true">↗</span>
            </a>
            <p class="story-note story-note--initiative">
              Self-initiated during professional engineering work; shared conceptually without
              private implementation details.
            </p>
          </div>
          <div
            class="story-visual notes-visual"
            role="group"
            aria-label="Conceptual engineering notes and their relationships"
          >
            <div class="visual-label">
              CONTEXT OVER TIME <span>FIG. 03</span>
            </div>
            <div class="note-stack">
              <div>
                <span>01</span> Architecture decisions <span>↗</span>
              </div>
              <div>
                <span>02</span> Working conventions <span>↗</span>
              </div>
              <div>
                <span>03</span> Lessons from changes <span>↗</span>
              </div>
            </div>
            <div class="visual-bottom">
              <span>KEEP WHAT MATTERS. RETRIEVE IT WHEN NEEDED.</span>
            </div>
          </div>
          <div class="work-frame-tail">
            <p class="work-disclaimer">
              A note on these projects: some of my most substantial work has been on private systems. I
              share the engineering ideas and lessons, not proprietary code, configuration, or customer
              details. The billing and Fleet diagrams are conceptual illustrations, not internal
              architecture documents; employer disclosure review remains outstanding.
            </p>
            <div class="work-directory-bridge">
              <div>
                <p class="work-directory-label">BEYOND THE HIGHLIGHTS</p>
                <p>
                  I've built other things too, from independent AI tools to earlier projects in algorithms
                  and web development. You can find them all here.
                </p>
              </div>
              <a class="work-directory-link" href="/projects/">
                Explore all projects <span aria-hidden="true">↗</span>
              </a>
            </div>
          </div>
          <nav class="stage-cue stage-cue--next" aria-label="Next section">
            <a href="#experience">
              <span class="stage-cue-arrow" aria-hidden="true">
                ↓
              </span>
              <span>Next: Experience</span>
            </a>
          </nav>
        </article>
      </div>
    </section>

    <section
      class="experience-section shell section-spacing"
      id="experience"
      tabindex="-1"
      data-scroll-stage
      aria-labelledby="experience-title"
    >
      <nav class="stage-cue stage-cue--previous" aria-label="Previous section">
        <a href="#ai-code-intelligence">
          <span class="stage-cue-arrow" aria-hidden="true">
            ↑
          </span>
          <span>Previous: AI Code Intelligence</span>
        </a>
      </nav>
      <div class="section-intro-row">
        <div>
          <p class="section-kicker">02 / EXPERIENCE</p>
          <h2 id="experience-title">
            Where I've <span class="serif-accent">worked.</span>
          </h2>
        </div>
        <p>
          A short timeline of my roles. The case studies above cover some of the systems I've worked
          on in more detail.
        </p>
      </div>
      <div class="experience-list">
        <article class="experience-entry">
          <div class="experience-company">
            <h3>Thales</h3>
            <p>Noida, India</p>
            <span>FEB 2023 — PRESENT</span>
          </div>
          <div class="experience-detail">
            <p class="experience-summary">
              Building backend and distributed systems across processing, orchestration,
              provisioning, and AI-powered engineering tooling.
            </p>
            <ol class="experience-roles" aria-label="Roles at Thales">
              <li>
                <strong>Software Engineer II</strong>
                <span>Jan 2024 – Present</span>
              </li>
              <li>
                <strong>Software Engineer I</strong>
                <span>Aug 2023 – Jan 2024</span>
              </li>
              <li>
                <strong>Software Engineer Intern</strong>
                <span>Feb 2023 – Aug 2023</span>
              </li>
            </ol>
          </div>
        </article>
        <article class="experience-entry">
          <div class="experience-company">
            <h3>Vinsol</h3>
            <p>Delhi, India</p>
            <span>JUN 2022 — JUL 2022</span>
          </div>
          <div class="experience-detail">
            <h4>Software Development Engineer Intern</h4>
            <p class="experience-summary">
              Worked on Ruby on Rails backend development and regression test automation using
              Selenium and Cucumber.
            </p>
          </div>
        </article>
      </div>
      <div class="work-directory-bridge">
        <div>
          <p class="work-directory-label">BEFORE THE PROFESSIONAL WORK</p>
          <p>
            Before I moved into backend engineering, I spent a lot of time solving algorithm
            problems and taking part in coding contests. I've kept my results and certificates here.
          </p>
        </div>
        <a class="work-directory-link" href="/achievements/">
          Explore achievements &amp; credentials <span aria-hidden="true">↗</span>
        </a>
      </div>
      <nav class="stage-cue stage-cue--next" aria-label="Next section">
        <a href="#explore">
          <span class="stage-cue-arrow" aria-hidden="true">
            ↓
          </span>
          <span>Next: Explore More</span>
        </a>
      </nav>
    </section>

    <section
      class="explore-section shell section-spacing"
      id="explore"
      tabindex="-1"
      data-scroll-stage
      aria-labelledby="explore-title"
    >
      <nav class="stage-cue stage-cue--previous" aria-label="Previous section">
        <a href="#experience">
          <span class="stage-cue-arrow" aria-hidden="true">
            ↑
          </span>
          <span>Previous: Experience</span>
        </a>
      </nav>
      <div class="section-intro-row explore-heading">
        <div>
          <p class="section-kicker">03 / EXPLORE MORE</p>
          <h2 id="explore-title">
            There's more <span class="serif-accent">to see.</span>
          </h2>
        </div>
        <p>
          I've also kept my other projects, competition results, and coding profiles here if you'd
          like to look further.
        </p>
      </div>
      <div class="explore-grid">
        <a class="explore-card" href="/projects/">
          <span class="explore-card-kicker">01 / PROJECTS</span>
          <h3>Other things I've built.</h3>
          <p>Independent tools and earlier projects, alongside my engineering work.</p>
          <span class="explore-card-action">
            Browse projects <span aria-hidden="true">↗</span>
          </span>
        </a>
        <a class="explore-card" href="/achievements/">
          <span class="explore-card-kicker">02 / ACHIEVEMENTS</span>
          <h3>Coding contest results.</h3>
          <p>Competition rankings, exam results, and the original supporting records.</p>
          <span class="explore-card-action">
            See results <span aria-hidden="true">↗</span>
          </span>
        </a>
        <a class="explore-card" href="/coding-profiles/">
          <span class="explore-card-kicker">03 / CODING PROFILES</span>
          <h3>Where I practiced.</h3>
          <p>My profiles across algorithms, interview practice, and coding contest platforms.</p>
          <span class="explore-card-action">
            Open profiles <span aria-hidden="true">↗</span>
          </span>
        </a>
      </div>
      <nav class="stage-cue stage-cue--next" aria-label="Next section">
        <a href="#about">
          <span class="stage-cue-arrow" aria-hidden="true">
            ↓
          </span>
          <span>Next: About</span>
        </a>
      </nav>
    </section>

    <section
      class="about-section"
      id="about"
      tabindex="-1"
      data-scroll-stage
      aria-labelledby="about-title"
    >
      <div class="shell">
        <nav class="stage-cue stage-cue--previous" aria-label="Previous section">
          <a href="#explore">
            <span class="stage-cue-arrow" aria-hidden="true">
              ↑
            </span>
            <span>Previous: Explore More</span>
          </a>
        </nav>
      </div>
      <div class="shell about-grid">
        <div>
          <p class="section-kicker">04 / A LITTLE ABOUT ME</p>
          <h2 id="about-title">
            A little <span class="serif-accent">about me.</span>
          </h2>
        </div>
        <div class="about-text">
          <p>
            I got into software through algorithms and competitive programming while studying
            Computer Science at JIIT. I liked working through the constraints and understanding why
            a solution worked, not just whether it passed.
          </p>
          <p>
            At Thales, I've learned how different a production system is from a coding problem.
            There's state across services, retries, failures, and other people who need to
            understand the design later. I enjoy working through the whole problem, from the
            requirement to the implementation and validation.
          </p>
          <p>
            Outside my regular work, I keep exploring algorithms, distributed systems, and developer
            tools. I'm particularly interested in helping AI tools retain useful context about a
            codebase instead of starting over in every session.
          </p>
          <div class="about-reference-links">
            <a
              class="underline-link"
              href={site.linkedin}
              target="_blank"
              rel="noopener noreferrer"
            >
              More about my experience on LinkedIn ↗
            </a>
            <a class="underline-link" href="/coding-profiles/">
              Explore coding profiles <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </div>
      <div class="shell">
        <nav class="stage-cue stage-cue--next" aria-label="Next section">
          <a href="#thinking">
            <span class="stage-cue-arrow" aria-hidden="true">
              ↓
            </span>
            <span>Next: Approach</span>
          </a>
        </nav>
      </div>
    </section>

    <section
      class="thinking-section shell section-spacing"
      id="thinking"
      tabindex="-1"
      data-scroll-stage
      aria-labelledby="thinking-title"
    >
      <nav class="stage-cue stage-cue--previous" aria-label="Previous section">
        <a href="#about">
          <span class="stage-cue-arrow" aria-hidden="true">
            ↑
          </span>
          <span>Previous: About</span>
        </a>
      </nav>
      <div class="section-intro-row thinking-heading">
        <div>
          <p class="section-kicker">05 / HOW I WORK</p>
          <h2 id="thinking-title">
            The details <span class="serif-accent">are the work.</span>
          </h2>
        </div>
        <p>Three things I pay attention to when building backend systems.</p>
      </div>
      <div class="lesson-list">
        <div>
          <span>01</span>
          <h3>Failures are part of the design.</h3>
          <p>
            Retries, duplicate results, partial progress, and restarts change how a system behaves.
            I try to account for them upfront.
          </p>
        </div>
        <div>
          <span>02</span>
          <h3>If it's hard to explain, I look again.</h3>
          <p>
            When a design needs too many special cases, I'd rather revisit the boundaries than add
            another exception.
          </p>
        </div>
        <div>
          <span>03</span>
          <h3>Numbers need context.</h3>
          <p>
            I don't trust a performance number without knowing the workload, the environment, and
            what was actually measured.
          </p>
        </div>
      </div>
      <nav class="stage-cue stage-cue--next" aria-label="Next section">
        <a href="#contact">
          <span class="stage-cue-arrow" aria-hidden="true">
            ↓
          </span>
          <span>Next: Contact</span>
        </a>
      </nav>
    </section>

    <section
      class="closing-section"
      id="contact"
      tabindex="-1"
      data-scroll-stage
      aria-labelledby="contact-title"
    >
      <div class="shell">
        <nav class="stage-cue stage-cue--previous" aria-label="Previous section">
          <a href="#thinking">
            <span class="stage-cue-arrow" aria-hidden="true">
              ↑
            </span>
            <span>Previous: Approach</span>
          </a>
        </nav>
      </div>
      <div class="shell closing-layout">
        <div>
          <p class="section-kicker">06 / SAY HELLO</p>
          <h2 id="contact-title">
            Have an interesting <span class="serif-accent">problem?</span>
          </h2>
          <p>
            I like talking about backend engineering, distributed systems, and developer tools. If
            something here caught your interest, feel free to reach out.
          </p>
        </div>
        <div class="closing-actions">
          <a
            class="button button-primary"
            href={site.linkedin}
            target="_blank"
            rel="noopener noreferrer"
          >
            Connect on LinkedIn ↗
          </a>
          <a class="underline-link" href={`mailto:${site.email}`}>
            {site.email}
          </a>
          <a class="underline-link" href={site.github} target="_blank" rel="noopener noreferrer">
            Find me on GitHub ↗
          </a>
        </div>
      </div>
    </section>
  </main>
  <script>
    import '../scripts/section-navigation';
  </script>
  <Footer credit="Designed and built with care." brandLabel="Back to homepage" />
</BaseLayout>
