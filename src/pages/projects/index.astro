---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/projects.css';

const previousProjects = [
  {
    number: '01',
    field: 'COMPUTER VISION · 3D GEOMETRY',
    title: '3D reconstruction from multiple 2D images',
    description:
      'I worked with front, side, and top views to recognize shapes and generate a 3D SCAD model and point-cloud representation. The interesting part was mapping those 2D views into a 3D model.',
    tags: ['Python', 'OpenCV', 'OpenSCAD'],
    links: [
      {
        label: 'Source code',
        url: 'https://github.com/Priyansh-15/3-D-Image-Build-from-Multiple-Images',
      },
      {
        label: 'Demo',
        url: 'https://user-images.githubusercontent.com/77832407/185854755-a4f994ed-cc8b-46bb-9e56-f5c265054b3e.mp4',
      },
      {
        label: 'Related article',
        url: 'https://priyansh15.medium.com/how-do-google-maps-actually-build-a-3d-environment-street-view-algorithm-explanation-1b64b7904c53',
      },
    ],
  },
  {
    number: '02',
    field: 'INFORMATION HIDING · ALGORITHMS',
    title: 'Steganography tools',
    description:
      'I experimented with hiding and recovering messages in images, text, audio, and video using LSB encoding, zero-width characters, and other techniques. This is an algorithms experiment, not an encryption tool.',
    tags: ['Python', 'LSB encoding', 'Steganography'],
    links: [
      { label: 'Source code', url: 'https://github.com/Priyansh-15/Steganography-Tools' },
      {
        label: 'Demo',
        url: 'https://user-images.githubusercontent.com/77832407/183821992-df55c835-ae41-4cd8-8253-6cbe7881eaf8.mp4',
      },
    ],
  },
  {
    number: '03',
    field: 'DEEP LEARNING · COMPUTER VISION',
    title: 'Ultrasound image classification with CNNs',
    description:
      'Built a convolutional neural network to classify a breast-ultrasound dataset into benign, malignant, and normal categories. An educational exploration of model architecture, training, validation, and image classification—not a clinical diagnostic system.',
    tags: ['Python', 'CNN', 'Image classification'],
    links: [
      {
        label: 'Source code',
        url: 'https://github.com/Priyansh-15/Breast-Cancer-Detection-Using-CNN-on-Ultrasound-Images',
      },
      {
        label: 'Demo',
        url: 'https://user-images.githubusercontent.com/77832407/215329706-5290af09-dc39-4099-a1d1-00fbcdcf8ca0.mp4',
      },
    ],
  },
  {
    number: '04',
    field: 'SEARCH ALGORITHMS · GAME AI',
    title: 'Mancala with Minimax',
    description:
      'Implemented a two-player Mancala game with player-versus-player and player-versus-bot modes. The bot uses Minimax with alpha-beta pruning to explore moves more efficiently.',
    tags: ['Python', 'Minimax', 'Alpha-beta pruning'],
    links: [
      {
        label: 'Source code',
        url: 'https://github.com/Priyansh-15/Mini-Max-Algorithm-Based-Mancala-Board-Game',
      },
    ],
  },
  {
    number: '05',
    field: 'EARLY MACHINE LEARNING · WEB APPLICATION',
    title: 'COVID-19 prediction prototype',
    description:
      'An early learning project combining a Random Forest classifier with a Flask web application deployed on Azure. It explored how a trained model could be exposed through an application; it was not medically validated.',
    tags: ['Python', 'Random Forest', 'Flask', 'Azure'],
    links: [
      { label: 'Source code', url: 'https://github.com/Priyansh-15/Covid19-Predictor' },
      {
        label: 'Demo video',
        url: 'https://user-images.githubusercontent.com/77832407/151757141-838533c6-f9f2-4a17-96db-5f186c6324.mp4',
      },
    ],
  },
  {
    number: '06',
    field: 'DATA STRUCTURES · DATASET OPERATIONS',
    title: 'Trie-based public call operations',
    description:
      'A C++ data-structure project exploring trie-based search and operations on a public-call dataset, including phonebook-style lookup and organization of records.',
    tags: ['C++', 'Tries', 'Data structures'],
    links: [
      {
        label: 'Source code',
        url: 'https://github.com/Priyansh-15/Public_Call_Operations_using_TRIES_data_structure',
      },
    ],
  },
  {
    number: '07',
    field: 'FULL-STACK WEB DEVELOPMENT',
    title: 'Shopping application with the MERN stack',
    description:
      'A learning project for building an online shopping application with product pages, user flows, a cart, and a MongoDB-backed server. An early end-to-end web development project.',
    tags: ['MongoDB', 'Express', 'React', 'Node.js'],
    links: [
      {
        label: 'Source code',
        url: 'https://github.com/Priyansh-15/Shopping_Website_Using_MERN_Stack',
      },
    ],
  },
];

const title = 'Engineering Work & Projects — Priyansh Sharma';
const description =
  'Professional systems, self-initiated AI engineering, independent products, and earlier technical projects by Priyansh Sharma.';
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main" class="projects-page">
    <section class="projects-hero shell" aria-labelledby="projects-title">
      <div class="projects-hero-top">
        <a class="projects-return" href="/#work">
          ← Back to the homepage
        </a>
        <span class="projects-mono">PROJECT INDEX / PRIYANSH SHARMA</span>
      </div>
      <div class="projects-hero-grid">
        <div class="projects-hero-content">
          <p class="projects-kicker">SELECTED ENGINEERING & INDEPENDENT PROJECTS</p>
          <h1 id="projects-title">
            Built at work. <em>Built on my own.</em>
          </h1>
          <p class="projects-lede">
            Some of these projects came from my work at Thales. Others started as ideas I wanted
            to try myself. I've kept both here, along with a few older projects.
          </p>
        </div>
        <div class="projects-hero-side">
          <span class="projects-small-label">THIS COLLECTION</span>
          <div>
            <strong>03</strong>
            <span>Professional engineering stories</span>
          </div>
          <div>
            <strong>01</strong>
            <span>Independent product in focus</span>
          </div>
          <div>
            <strong>07</strong>
            <span>Earlier technical projects</span>
          </div>
        </div>
      </div>
      <nav class="projects-jump" aria-label="Browse project categories">
        <a href="#professional">
          01 / Professional engineering <span aria-hidden="true">↓</span>
        </a>
        <a href="#independent">
          02 / Independent product <span aria-hidden="true">↓</span>
        </a>
        <a href="#earlier">
          03 / Earlier projects <span aria-hidden="true">↓</span>
        </a>
      </nav>
    </section>

    <section
      class="projects-section shell"
      id="professional"
      tabindex="-1"
      aria-labelledby="professional-title"
    >
      <div class="projects-section-header">
        <div>
          <p class="projects-kicker">01 / PROFESSIONAL ENGINEERING</p>
          <h2 id="professional-title">
            Systems with <em>real constraints.</em>
          </h2>
        </div>
        <p>
          Backend work where reliability, recovery, and existing integrations shaped the design.
        </p>
      </div>

      <div class="projects-professional-list">
        <article class="projects-professional-card">
          <div class="projects-card-content">
            <p class="projects-card-meta">
              <span>01 / DISTRIBUTED PROCESSING</span>
              <span>THALES</span>
            </p>
            <h3>
              Making distributed billing <em>finish correctly.</em>
            </h3>
            <p>
              I architected and implemented the core of a distributed bill-run engine. The challenge
              was to preserve pricing semantics across parallel stages and keep progress recoverable
              when workers were interrupted.
            </p>
            <div class="projects-tags">
              <span>Java</span>
              <span>Cassandra</span>
              <span>Concurrency</span>
              <span>Recovery</span>
            </div>
            <a class="projects-action" href="/work/distributed-billing/">
              Read engineering case study <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="projects-schema" aria-label="Conceptual distributed processing stages">
            <div class="projects-schema-header">
              A SYSTEM IN STAGES <span>FIG. 01</span>
            </div>
            <div class="projects-schema-nodes">
              <span>MAP</span>
              <b aria-hidden="true">→</b>
              <span>REDUCE</span>
              <b aria-hidden="true">→</b>
              <span>FINALIZE</span>
            </div>
            <p>Durable coordination between stages</p>
          </div>
        </article>

        <article class="projects-professional-card">
          <div class="projects-card-content">
            <p class="projects-card-meta">
              <span>02 / SYSTEM DESIGN</span>
              <span>THALES</span>
            </p>
            <h3>
              Making Fleet interactions <em>easier to reason about.</em>
            </h3>
            <p>
              I designed and implemented a framework within an existing order scheduler, separating
              interaction planning from execution. The work had to respect established behavior
              while making future changes more predictable and testable.
            </p>
            <div class="projects-tags">
              <span>Orchestration</span>
              <span>Architecture</span>
              <span>Reliability</span>
            </div>
            <a class="projects-action" href="/work/order-scheduler/">
              Read engineering case study <span aria-hidden="true">↗</span>
            </a>
          </div>
          <div class="projects-schema" aria-label="Conceptual split between planning and execution">
            <div class="projects-schema-header">
              SEPARATE THE CONCERNS <span>FIG. 02</span>
            </div>
            <div class="projects-schema-nodes projects-schema-pair">
              <span>PLAN</span>
              <b aria-hidden="true">↔</b>
              <span>EXECUTE</span>
            </div>
            <p>Decisions and side effects have different responsibilities</p>
          </div>
        </article>

        <article class="projects-professional-card projects-professional-ai" id="code-intelligence">
          <div class="projects-card-content">
            <p class="projects-card-meta">
              <span>03 / SELF-INITIATED ENGINEERING</span>
              <span>TEAM ADOPTION</span>
            </p>
            <h3>
              Helping AI understand <em>the code around it.</em>
            </h3>
            <p>
              While working with large backend codebases, I kept seeing the same problem: AI tools
              lost important architecture, conventions, and context between sessions. I took the
              initiative to build a persistent engineering knowledge system—not as an assigned
              project, but because I wanted to fix that problem.
            </p>
            <p>
              It uses structured architectural context, AST-aware indexing, Qdrant/Neo4j retrieval,
              and MCP integrations. What started as my own initiative was eventually adopted by my
              entire team.
            </p>
            <div class="projects-tags">
              <span>Code intelligence</span>
              <span>AST-aware indexing</span>
              <span>MCP</span>
              <span>Qdrant / Neo4j</span>
            </div>
            <p class="projects-context-note">
              Self-initiated during professional engineering work. Described conceptually; no
              private code or internal architecture is published.
            </p>
          </div>
          <div class="projects-schema" aria-label="Conceptual engineering context workflow">
            <div class="projects-schema-header">
              CONTEXT THAT LASTS <span>FIG. 03</span>
            </div>
            <div class="projects-schema-stack">
              <div>
                <span>01</span> Understand code structure
              </div>
              <div>
                <span>02</span> Preserve engineering knowledge
              </div>
              <div>
                <span>03</span> Retrieve context when needed
              </div>
            </div>
            <p>Built independently · Adopted by the team</p>
          </div>
        </article>
      </div>

      <p class="projects-privacy-note">
        These professional engineering stories describe my responsibilities and lessons through
        conceptual explanations. They do not reproduce employer source code, operational details, or
        confidential systems.
      </p>
    </section>

    <section
      class="projects-independent"
      id="independent"
      tabindex="-1"
      aria-labelledby="independent-title"
    >
      <div class="shell projects-independent-inner">
        <div class="projects-section-header">
          <div>
            <p class="projects-kicker">02 / INDEPENDENT PRODUCT</p>
            <h2 id="independent-title">
              An idea I <em>kept building.</em>
            </h2>
          </div>
          <p>
            I started this outside my regular work to solve a problem I kept running into myself.
          </p>
        </div>
        <article class="projects-independent-feature">
          <div class="projects-independent-story">
            <div class="projects-feature-label">
              <span>FEATURED INDEPENDENT PROJECT</span>
              <span>AI / PRODUCT ENGINEERING</span>
            </div>
            <h3>
              Job Find Helper <em>— AI Career Intelligence.</em>
            </h3>
            <p>
              Job openings are scattered across company portals, while figuring out which roles
              actually fit a candidate takes its own effort. I built a platform to collect,
              synchronize, deduplicate, and classify openings, then rank them using more than
              keyword matching.
            </p>
            <p>
              The recommendation approach combines semantic embeddings, skills, and
              recruitment-history signals with LLM-based explanations of possible skill gaps.
              Ranking quality is evaluated with Precision@K and NDCG@K.
            </p>
            <div class="projects-tags">
              <span>Python</span>
              <span>FastAPI</span>
              <span>React</span>
              <span>Embeddings</span>
              <span>LLMs</span>
              <span>Ranking evaluation</span>
            </div>
            <a
              class="projects-action"
              href="https://github.com/Priyansh-15/Job_Helper"
              target="_blank"
              rel="noopener noreferrer"
            >
              View earlier public version on GitHub <span aria-hidden="true">↗</span>
            </a>
            <p class="projects-context-note">
              The current version is private. The public repository is an older version and doesn't
              include everything described above.
            </p>
          </div>
          <div class="projects-independent-aside" aria-label="Project capabilities">
            <div class="projects-feature-step">
              <span>01 / GATHER</span>
              <strong>One place for openings</strong>
              <p>Aggregation, synchronization, deduplication and role classification.</p>
            </div>
            <div class="projects-feature-step">
              <span>02 / MATCH</span>
              <strong>Go beyond keywords</strong>
              <p>Semantic similarity, skills and hybrid recommendation signals.</p>
            </div>
            <div class="projects-feature-step">
              <span>03 / EXPLAIN</span>
              <strong>Make rankings useful</strong>
              <p>LLM-based skill-gap explanations and relevance evaluation.</p>
            </div>
          </div>
        </article>
      </div>
    </section>

    <section
      class="projects-section projects-earlier shell"
      id="earlier"
      tabindex="-1"
      aria-labelledby="earlier-title"
    >
      <div class="projects-section-header">
        <div>
          <p class="projects-kicker">03 / EARLIER PROJECTS</p>
          <h2 id="earlier-title">
            Where some of the <em>curiosity started.</em>
          </h2>
        </div>
        <p>
          These are projects I built while learning computer vision, algorithms, machine learning,
          and full-stack development.
        </p>
      </div>
      <div class="projects-archive-grid">
        {previousProjects.map((project) => (
          <article class="projects-archive-card">
            <div class="projects-archive-topline">
              <span>{project.number} / 07</span>
              <span>{project.field}</span>
            </div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
            <div class="projects-archive-bottom">
              <div class="projects-tags">
                {project.tags.map((tag) => (
                  <span>{tag}</span>
                ))}
              </div>
              <div class="projects-archive-links">
                {project.links.map((link) => (
                  <a href={link.url} target="_blank" rel="noopener noreferrer">
                    {link.label} <span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="projects-lastword" aria-labelledby="projects-lastword-title">
      <div class="shell projects-lastword-inner">
        <div>
          <p class="projects-kicker">STILL BUILDING</p>
          <h2 id="projects-lastword-title">
            I'm still <em>building.</em>
          </h2>
          <p>
            I'll keep improving these projects and adding new ones as I go.
          </p>
        </div>
        <div class="projects-lastword-links">
          <a class="button button-primary" href="/#contact">
            Get in touch <span aria-hidden="true">↗</span>
          </a>
          <a
            class="projects-action"
            href="https://github.com/Priyansh-15"
            target="_blank"
            rel="noopener noreferrer"
          >
            More on GitHub <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer credit="Designed and built with care." brandLabel="Back to homepage" />
</BaseLayout>
