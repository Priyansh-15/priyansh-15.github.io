---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import '../../styles/work-index.css';

const studies = [
  {
    number: '01',
    type: 'DISTRIBUTED PROCESSING',
    title: 'Designing the core engine for distributed billing.',
    description:
      'From pricing and aggregation to Cassandra-backed coordination, this case study explores how I designed a bill-run pipeline to recover from interruptions without losing track of progress.',
    tags: ['Java', 'Concurrency', 'Cassandra'],
    href: '/work/distributed-billing/',
    link: 'Read the billing case study',
  },
  {
    number: '02',
    type: 'ORCHESTRATION & SYSTEM DESIGN',
    title: 'Redesigning Fleet interaction orchestration.',
    description:
      'An account of separating planning from execution in Order Scheduler while preserving existing behavior, with reliability and changeability as central design constraints.',
    tags: ['Architecture', 'Orchestration', 'Reliability'],
    href: '/work/order-scheduler/',
    link: 'Read the Fleet case study',
  },
] as const;
---

<BaseLayout
  title="Engineering Work — Priyansh Sharma"
  description="Selected engineering work by Priyansh Sharma: distributed billing, Fleet orchestration, and an independently initiated AI code intelligence system."
>
  <Header />
  <main id="main" class="work-index">
    <section class="work-index-hero shell" aria-labelledby="work-index-title">
      <div class="work-index-topline">
        <a href="/" class="work-index-return">
          ← Back to the homepage
        </a>
        <span>WORK / PRIYANSH SHARMA</span>
      </div>
      <div class="work-index-intro">
        <p class="work-index-kicker">ENGINEERING / SELECTED WORK</p>
        <h1 id="work-index-title">
          Work that needed <em>more than code.</em>
        </h1>
        <p class="work-index-lede">
          The problems that have shaped how I design software: coordinating distributed processing,
          separating decisions from execution, and giving engineering tools better context. These
          are selected stories, not a catalogue of every task.
        </p>
      </div>
      <nav class="work-index-jump" aria-label="On this page">
        <a href="#case-studies">
          Professional case studies <span aria-hidden="true">↗</span>
        </a>
        <a href="#independent-initiative">
          Independent initiative <span aria-hidden="true">↗</span>
        </a>
        <a href="#explore-more">
          More to explore <span aria-hidden="true">↗</span>
        </a>
      </nav>
    </section>

    <section
      class="work-index-section shell"
      id="case-studies"
      tabindex="-1"
      aria-labelledby="work-studies-title"
    >
      <div class="work-index-section-heading">
        <div>
          <p class="work-index-kicker">01 / PROFESSIONAL WORK</p>
          <h2 id="work-studies-title">
            Engineering decisions, <em>explained.</em>
          </h2>
        </div>
        <p>
          Each case study focuses on constraints, tradeoffs, and failure handling. The illustrations
          are conceptual rather than internal design documents.
        </p>
      </div>
      <ol class="work-index-study-list">
        {studies.map((study) => (
          <li class="work-index-study">
            <div class="work-index-study-meta">
              <span>
                {study.number} / {study.type}
              </span>
              <span>PROFESSIONAL WORK</span>
            </div>
            <h3>{study.title}</h3>
            <p>{study.description}</p>
            <ul class="work-index-tags" aria-label="Topics">
              {study.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <a class="work-index-action" href={study.href}>
              {study.link} <span aria-hidden="true">↗</span>
            </a>
          </li>
        ))}
      </ol>
      <p class="work-index-disclosure">
        Some of my most substantial work is on private systems. I share the engineering reasoning
        and conceptual designs, not proprietary code, configurations, or customer details. Employer
        disclosure review remains outstanding.
      </p>
    </section>

    <section
      class="work-index-initiative"
      id="independent-initiative"
      tabindex="-1"
      aria-labelledby="work-initiative-title"
    >
      <div class="shell work-index-initiative-grid">
        <div>
          <p class="work-index-kicker">02 / SELF-INITIATED ENGINEERING</p>
          <h2 id="work-initiative-title">
            Building context for <em>AI-assisted engineering.</em>
          </h2>
        </div>
        <div>
          <p>
            While working on large backend codebases at Thales, I independently started building a
            persistent code intelligence system to address context loss between AI sessions. It
            later became a tool my whole team adopted.
          </p>
          <p>
            This was my own initiative, developed alongside professional engineering work. The
            public project overview describes the approach without exposing private implementations.
          </p>
          <a class="work-index-action" href="/projects/#code-intelligence">
            Explore the code intelligence initiative <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
    </section>

    <section
      class="work-index-section shell work-index-more"
      id="explore-more"
      tabindex="-1"
      aria-labelledby="work-more-title"
    >
      <p class="work-index-kicker">03 / KEEP EXPLORING</p>
      <h2 id="work-more-title">
        There's more <em>behind the highlights.</em>
      </h2>
      <div class="work-index-more-links">
        <a href="/projects/">
          <strong>All projects</strong>
          <span>
            Professional, independent, and earlier work <span aria-hidden="true">↗</span>
          </span>
        </a>
        <a href="/#experience">
          <strong>Experience</strong>
          <span>
            Roles and career timeline <span aria-hidden="true">↗</span>
          </span>
        </a>
        <a href="/achievements/">
          <strong>Achievements</strong>
          <span>
            Competitions and credentials <span aria-hidden="true">↗</span>
          </span>
        </a>
        <a href="/coding-profiles/">
          <strong>Coding profiles</strong>
          <span>
            Algorithms and competitive programming <span aria-hidden="true">↗</span>
          </span>
        </a>
      </div>
    </section>
  </main>
  <Footer credit="Designed and built with care." brandLabel="Back to homepage" />
</BaseLayout>
