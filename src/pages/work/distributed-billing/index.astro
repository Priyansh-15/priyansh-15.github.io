---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import ArticleNavigation from '../../../components/ArticleNavigation.astro';
const articleNavigation = [
  { href: '#overview', label: '01 / The problem' },
  { href: '#architecture', label: '02 / System model' },
  { href: '#ownership', label: '03 / Ownership' },
  { href: '#failures', label: '04 / Failure walkthroughs' },
  { href: '#decisions', label: '05 / Tradeoffs' },
  { href: '#validation', label: '06 / Verification' },
  { href: '#reflection', label: '07 / What I took away' },
] as const;
const title = 'Designing a Distributed Billing Pipeline — Priyansh Sharma';
const description =
  'An engineering case study about processing stages, durable ownership, recovery, and verification in a distributed billing and reporting pipeline.';
const scenarios = [
  {
    num: '01',
    name: 'Worker loses ownership',
    event:
      'Worker A checks its claim, then pauses before publishing long enough for the claim to expire.',
    risk: 'Worker B takes over, but A later uses its earlier check to publish a stale result.',
    design:
      'Reject obsolete authority where a result becomes authoritative. A separate ownership check before the write leaves a race; a lease alone cannot protect that boundary.',
    check:
      'Pause A after its ownership check. Let its claim expire, let B take over and publish, then resume A. Assert that A cannot become authoritative and the logical contribution is not applied twice.',
  },
  {
    num: '02',
    name: 'Write succeeds; acknowledgement fails',
    event:
      'A result write succeeds, but its acknowledgement is lost. The worker cannot tell whether the write took effect.',
    risk: 'Treating the missing acknowledgement or timeout as proof of failure can lead a retry to apply the contribution again.',
    design:
      'Keep the logical contribution identity stable within its bill run and make acceptance idempotent. Recording acceptance and applying the contribution must agree even after interruption; an identity alone does not ensure this.',
    check:
      'Persist a contribution, suppress its acknowledgement, then retry it with the same logical identity. Allow repeated computation, but assert one applied contribution and an unchanged downstream result against a known-correct baseline.',
  },
  {
    num: '03',
    name: 'A stage partially completes',
    event:
      'Some expected contributions finish while another remains missing; a completed contribution may also be retried.',
    risk: 'An output count can appear complete despite a missing contribution if duplicates are counted as distinct work.',
    design:
      'Define the expected contributions for the run. Gate stage completion on valid, durable completion evidence for each one, with no missing contribution or duplicate logical application. Partial output alone is insufficient.',
    check:
      'Withhold one required contribution and replay a completed one. Assert that downstream finalization remains blocked. Then complete the missing contribution and verify that valid completion evidence allows the stage to advance without double application.',
  },
  {
    num: '04',
    name: 'Retries compete with useful work',
    event: 'A shared dependency slows down or remains unavailable while multiple workers retry.',
    risk: 'Retries consume capacity needed for useful work; independent per-worker limits can still overload the shared dependency.',
    design:
      'Bound attempts per logical task and limit aggregate in-flight work against the shared dependency. Define retry spacing and what happens when the budget is exhausted; persistent failure must remain visible rather than appearing complete.',
    check:
      'Inject transient and persistent failures. Observe retry rate, aggregate concurrency, useful throughput, and backlog. Verify the configured limits and budget-exhaustion behavior; check recovery only when dependencies recover and retry budget remains.',
  },
];
const decisions = [
  {
    name: 'Parallelize mapping',
    why: 'Independent event partitions offer natural concurrency.',
    cost: 'More partitions increase coordination writes, scheduling overhead, and result fan-in.',
  },
  {
    name: 'Make phase boundaries durable',
    why: 'A restart should not have to guess which processing phase is complete.',
    cost: 'Durable checkpoints add state transitions and storage activity.',
  },
  {
    name: 'Recover abandoned work',
    why: 'One interrupted worker should not permanently block a reporting run.',
    cost: 'Lease expiry must account for slow but live workers; reclamation introduces stale-owner races.',
  },
  {
    name: 'Gate report finalization',
    why: 'A report must represent a complete, consistent set of contributions.',
    cost: 'Stragglers can delay completion; partial progress must remain visible without appearing final.',
  },
];
---

<BaseLayout title={title} description={description}>
  <Header />
  <main id="main" class="case-page case-v23">
    <div class="shell case-hero">
      <a href="/#work" class="case-back">
        ← Back to selected work
      </a>
      <div class="case-meta">
        <span>ENGINEERING STORY / 01</span>
        <span>BACKEND · CONCURRENT PROCESSING · RELIABILITY</span>
      </div>
      <h1>
        Making distributed billing <em>finish correctly.</em>
      </h1>
      <p class="case-standfirst">
        Usage-based billing had to apply configured prices and discount tiers per device or across a
        tenant's usage. I architected and implemented the core distributed bill-run engine behind
        that requirement. The challenge was to preserve those billing semantics across concurrent
        work and know when a report was complete, including after an interruption.
      </p>
      <div class="case-byline">
        <span>By Priyansh Sharma</span>
        <span>Backend engineering · Thales</span>
        <span>Public-safe architectural walkthrough</span>
      </div>
    </div>

    <div class="shell case-layout">
      <ArticleNavigation items={articleNavigation} />
      <article class="case-prose">
        <div class="case-disclosure">
          <strong>Scope and attribution.</strong> My ownership covered the core bill-run engine;
          other engineers contributed supporting ingestion, bucketing, and API functionality. The
          diagrams, failure examples, and validation scenarios below are educational abstractions,{' '}
          <em>not</em> documentation of Thales' production architecture or claims that every
          described test was performed. No internal code, operational configuration, or confidential
          measurements are reproduced.
        </div>

        <section id="overview" class="case-section">
          <p class="case-label">01 / THE PROBLEM</p>
          <h2>Pricing rules shaped the execution problem.</h2>
          <p>
            The requirement was to calculate usage-based charges from billable events, configured
            unit prices, and configurable slicing and discount tiers. Horizontal slicing evaluated
            discount tiers per device or card; vertical slicing evaluated them across the tenant's
            usage.
          </p>
          <p>
            Starting from that high-level requirement, I independently architected and implemented
            the core distributed bill-run engine. My implementation covered the mapper, reducer,
            finalizer, and reporting phases, with work partitioned for parallel execution.
          </p>
          <div class="case-highlight">
            <span>THE CENTRAL QUESTION</span>
            <strong>
              How could I preserve the selected billing semantics across concurrent work and know
              when every required contribution to a report was complete?
            </strong>
          </div>
          <p>
            Partitioning the work also meant coordinating when stages could advance. I had to
            account for checkpointing and recovery from interrupted execution, so that partial
            progress would not be mistaken for a completed report. Completion needed to be a shared
            decision that remained meaningful when individual workers stopped or restarted.
          </p>
        </section>

        <section id="architecture" class="case-section">
          <p class="case-label">02 / A SYSTEM MODEL</p>
          <h2>Separate the data being processed from the decisions about progress.</h2>
          <p>
            I used Cassandra-backed distributed coordination to synchronize execution stages
            durably. A completion signal held only in one process could not serve as a reliable
            shared source of truth when independent workers could be interrupted or restarted.
            Durable coordination let progress and stage-completion decisions survive those
            interruptions, at the cost of additional state management and coordination overhead.
          </p>
          <p>
            The conceptual model below separates the <em>data plane</em>, where events are processed
            and contributions combined, from the <em>control plane</em>, where ownership and stage
            progression are coordinated. It compresses finalization and reporting into the final
            output step; it is not an exact four-phase production topology.
          </p>
          <figure class="v23-architecture">
            <div class="v23-figure-heading">
              <span>FIG. 01 / SIMPLIFIED EXECUTION MODEL</span>
              <span>CONCEPTUAL, NOT PRODUCTION TOPOLOGY</span>
            </div>
            <div class="v23-arch-inner">
              <div class="v23-plane-label">
                DATA PLANE <span>· process contributions</span>
              </div>
              <div class="v23-flow">
                <div class="v23-stage">
                  <small>INPUT</small>
                  <strong>Events</strong>
                  <span>Source records</span>
                </div>
                <span class="v23-arrow" aria-hidden="true">
                  →
                </span>
                <div class="v23-stage v23-stage-featured">
                  <small>FAN OUT</small>
                  <strong>Map</strong>
                  <span>Independent partitions</span>
                  <span class="v23-subnodes" aria-hidden="true">
                    P1 · P2 · P3
                  </span>
                </div>
                <span class="v23-arrow" aria-hidden="true">
                  →
                </span>
                <div class="v23-stage">
                  <small>FAN IN</small>
                  <strong>Reduce</strong>
                  <span>Combine contributions</span>
                </div>
                <span class="v23-arrow" aria-hidden="true">
                  →
                </span>
                <div class="v23-stage">
                  <small>PUBLISH</small>
                  <strong>Finalize</strong>
                  <span>Complete report</span>
                </div>
              </div>
              <div class="v23-plane-link" aria-hidden="true">
                <span>↓</span>
                <span>state &amp; progress</span>
                <span>↑</span>
              </div>
              <div class="v23-control">
                <div>
                  <small>CONTROL PLANE</small>
                  <strong>Coordinator</strong>
                  <span>Task claims · expiry · stage barrier · retry decisions</span>
                </div>
                <div>
                  <small>DURABLE STATE</small>
                  <strong>Persistent coordination records</strong>
                  <span>Ownership and completion survive worker interruption</span>
                </div>
              </div>
            </div>
            <figcaption>
              This diagram illustrates responsibilities and correctness boundaries. It omits
              internal service names, storage schemas, and deployment details.
            </figcaption>
          </figure>
          <p>
            The completion requirement carries through each stage:{' '}
            <strong>
              the existence of intermediate output cannot be the sole proof of stage completion.
            </strong>{' '}
            In this model, a reducer needs to know which contributions were expected and which were
            committed before treating its input as complete. Durable progress alone does not settle
            whether an overlapping or retried attempt may publish a result. That ownership question
            is the next part of the design discussion.
          </p>
        </section>

        <section id="ownership" class="case-section">
          <p class="case-label">03 / OWNERSHIP AND COMPLETION</p>
          <h2>A lease is not a guarantee that work ran only once.</h2>
          <p>
            A lease is a time-bounded claim coordinating which worker should attempt a task. It does
            not stop a paused worker from resuming after its claim expires. Each execution is a
            physical attempt; several attempts can belong to the same logical contribution in a
            particular bill run. Repeating computation need not mean applying that contribution
            again.
          </p>
          <p>
            The critical question is where a result becomes authoritative for downstream processing.
            Checking ownership and publishing later leaves a gap in which authority can change. In
            the conceptual sequence below, A pauses after checking its claim. B takes over and
            attempts publication before A resumes. A's earlier check cannot authorize its later
            write.
          </p>
          <div class="v23-timeline" aria-label="Illustrative lease expiry race">
            <div class="v23-timeline-head">
              <span>ILLUSTRATIVE TIMELINE</span>
              <span>NOT AN INCIDENT REPORT</span>
            </div>
            <div class="v23-timeline-row">
              <span>T0</span>
              <strong>Worker A checks its claim</strong>
              <p>A's claim is valid at the check, before publication.</p>
            </div>
            <div class="v23-timeline-row">
              <span>T1</span>
              <strong>Worker A pauses</strong>
              <p>A pauses before writing; its claim expires during the pause.</p>
            </div>
            <div class="v23-timeline-row">
              <span>T2</span>
              <strong>Worker B reclaims task</strong>
              <p>B takes over, completes the work, and attempts to publish its result.</p>
            </div>
            <div class="v23-timeline-row">
              <span>T3</span>
              <strong>Worker A resumes</strong>
              <p>A attempts to publish using its earlier check, after B has taken over.</p>
            </div>
          </div>
          <div class="case-callout">
            <span>DESIGN INVARIANT</span>
            <p>
              At the point a result becomes authoritative, stale attempts must be rejected and the
              same logical contribution must not be applied twice within its bill run. A successful
              write alone does not establish that these conditions hold.
            </p>
          </div>
          <p>
            These protections have different jobs. A guarded transition or version/fencing check can
            reject obsolete authority when enforced <em>where the effect is accepted</em>. Guarding
            a coordination record does not automatically protect a write to another resource. Stable
            identity associates retries with one logical contribution; idempotent acceptance keeps
            that contribution from being applied again. Identity alone does not enforce this.
            Durable completion evidence serves a separate purpose: establishing that every expected
            contribution is validly complete before advancing a stage. These are conceptual design
            options, not claims that my implementation used each mechanism.
          </p>
        </section>

        <section id="failures" class="case-section">
          <p class="case-label">04 / FAILURE WALKTHROUGHS</p>
          <h2>Four scenarios worth designing before the happy path is done.</h2>
          <p>
            These hypothetical scenarios pair a failure with an acceptance rule and a proposed test.
            Bounded retries and concurrency can limit retry pressure, but cannot guarantee success.
            Recovery depends on which failures persist, remaining retry budget, dependency
            availability, and workers being able to make progress.
          </p>
          <div class="v23-scenarios">
            {scenarios.map((scenario) => (
              <details class="v23-scenario">
                <summary>
                  <span class="v23-number">{scenario.num}</span>
                  <span>{scenario.name}</span>
                  <span class="v23-plus" aria-hidden="true">
                    +
                  </span>
                </summary>
                <div class="v23-scenario-body">
                  <div>
                    <small>TRIGGER</small>
                    <p>{scenario.event}</p>
                  </div>
                  <div>
                    <small>WHAT CAN GO WRONG</small>
                    <p>{scenario.risk}</p>
                  </div>
                  <div>
                    <small>DESIGN RESPONSE</small>
                    <p>{scenario.design}</p>
                  </div>
                  <div>
                    <small>HOW TO TEST THE IDEA</small>
                    <p>{scenario.check}</p>
                  </div>
                </div>
              </details>
            ))}
          </div>
          <p class="v23-caption-text">
            These examples illustrate possible failure modes; they are not claims about specific
            bugs or incidents at Thales.
          </p>
        </section>

        <section id="decisions" class="case-section">
          <p class="case-label">05 / TRADEOFFS</p>
          <h2 id="billing-tradeoffs-title">Each reliability decision has a cost.</h2>
          <p>
            One thing I've learned from working on processing frameworks is that “more parallel” and
            “more reliable” aren't free settings. Every additional partition and checkpoint has an
            operational price.
          </p>
          <div
            class="v23-decision-table"
            role="region"
            aria-label="Billing architecture tradeoffs — scrollable table"
            tabindex="0"
          >
            <table aria-labelledby="billing-tradeoffs-title">
              <thead>
                <tr>
                  <th scope="col">Decision</th>
                  <th scope="col">Why it helps</th>
                  <th scope="col">What it costs</th>
                </tr>
              </thead>
              <tbody>
                {decisions.map((d) => (
                  <tr>
                    <th scope="row">{d.name}</th>
                    <td>{d.why}</td>
                    <td>{d.cost}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          <p>
            I'd rather explain these costs honestly than present a larger worker count as an
            achievement on its own. Concurrency is valuable when the end-to-end result improves{' '}
            <em>without weakening correctness.</em>
          </p>
        </section>

        <section id="validation" class="case-section">
          <p class="case-label">06 / VALIDATION</p>
          <h2>The measurement is only useful if you can explain it.</h2>
          <p>
            On the billing project, I worked with large event volumes and reporting performance
            tests. I don't want to put a number on a public website unless it is verified, approved
            to disclose, and accompanied by its measurement conditions.
          </p>
          <div class="v23-validation-grid">
            <div>
              <span>01 / CORRECTNESS</span>
              <strong>Consistent report output</strong>
              <p>
                Compare generated results against a baseline; test duplicate attempts and missing
                contributions.
              </p>
            </div>
            <div>
              <span>02 / RECOVERY</span>
              <strong>Converges after interruption</strong>
              <p>
                Introduce worker loss, delayed acknowledgements, and retry overlap; verify eventual
                valid completion.
              </p>
            </div>
            <div>
              <span>03 / PERFORMANCE</span>
              <strong>Explain the workload</strong>
              <p>
                Record event count, distribution, run scope, concurrency, environment, elapsed time,
                and what is excluded.
              </p>
            </div>
            <div>
              <span>04 / BOTTLENECKS</span>
              <strong>See the entire pipeline</strong>
              <p>
                Measure stage duration, coordination pressure, stragglers, aggregation, and
                finalization separately.
              </p>
            </div>
          </div>
          <div class="case-callout">
            <span>BENCHMARK DISCLOSURE</span>
            <p>
              Public figures are intentionally withheld here until confirmed against test evidence
              and approved for publication. This avoids turning an internal lab result into an
              unsupported production-scale claim.
            </p>
          </div>
        </section>

        <section id="reflection" class="case-section case-final-section">
          <p class="case-label">07 / WHAT I TOOK AWAY</p>
          <h2>I think about completion differently now.</h2>
          <p>
            The useful shift for me was from asking <em>“How fast can we process these events?”</em>{' '}
            to asking{' '}
            <em>
              “What would convince us that the full result is correct, durable, and safe to
              publish?”
            </em>
          </p>
          <p>
            That question changes your approach to worker ownership, stage boundaries, recovery,
            testing, and observability. It also makes performance numbers more meaningful: you can
            say what finished, not just what ran.
          </p>
          <p>
            Some implementation details have to remain private, but the engineering lessons are
            worth sharing. They're also the questions I keep bringing to new distributed-systems
            work.
          </p>
          <div class="v23-story-end">
            <div>
              <span>THANKS FOR READING</span>
              <strong>Have an interesting systems problem?</strong>
            </div>
            <a href="/#contact">
              Let's talk <span aria-hidden="true">↗</span>
            </a>
          </div>
        </section>
        <div class="case-next">
          <span>MORE TO EXPLORE</span>
          <a href="/#work">
            Back to selected engineering work <span aria-hidden="true">↗</span>
          </a>
        </div>
      </article>
    </div>
  </main>
  <Footer credit="Built with care." />
</BaseLayout>
